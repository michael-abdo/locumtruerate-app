# Application
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vanilla_api_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Database URLs (alternative to individual settings)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vanilla_api_dev

# JWT Configuration
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:4000

# API Keys (for future use)
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=

# Logging
LOG_LEVEL=debug